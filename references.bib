@misc{pont_convex_2024,
    title = {Convex sets can have interior hot spots},
    url = {http://arxiv.org/abs/2412.06344},
    doi = {10.48550/arXiv.2412.06344},
    abstract = {The hot spots conjecture asserts that for any convex bounded domain \${\textbackslash}Omega\$ in \${\textbackslash}mathbb R{\textasciicircum}d\$, the first non-trivial Neumann eigenfunction of the Laplace operator in \${\textbackslash}Omega\$ attains its maximum at the boundary. We construct counterexamples to the conjecture for all sufficiently large values of \$d\$. The construction is based on an extension of the conjecture from convex sets to log-concave measures.},
    urldate = {2025-06-29},
    publisher = {arXiv},
    author = {Pont, Jaume de Dios},
    month = dec,
    year = {2024},
    note = {arXiv:2412.06344 [math]},
    keywords = {Mathematics - Analysis of PDEs, Mathematics - Spectral Theory},
}
@article{wang_logarithmic_1997,
    title = {Logarithmic {Sobolev} inequalities on noncompact {Riemannian} manifolds},
    volume = {109},
    issn = {1432-2064},
    url = {https://doi.org/10.1007/s004400050137},
    doi = {10.1007/s004400050137},
    abstract = {This paper presents a dimension-free Harnack type inequality for heat semigroups on manifolds, from which a dimension-free lower bound is obtained for the logarithmic Sobolev constant on compact manifolds and a new criterion is proved for the logarithmic Sobolev inequalities (abbrev. LSI) on noncompact manifolds. As a result, it is shown that LSI may hold even though the curvature of the operator is negative everywhere.},
    language = {en},
    number = {3},
    urldate = {2025-07-04},
    journal = {Probability Theory and Related Fields},
    author = {Wang, Feng-Yu},
